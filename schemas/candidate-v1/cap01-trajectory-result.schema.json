{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guivos-repositorio.github.io/Guivos-AI/schemas/candidate-v1/cap01-trajectory-result.schema.json",
  "title": "cap01-trajectory-result candidate-1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "events",
    "context_version",
    "limitations"
  ],
  "properties": {
    "capability_id": {
      "const": "GAI-CAP-01"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_ref",
          "source_refs",
          "epistemic_status"
        ],
        "properties": {
          "event_ref": {
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "epistemic_status": {
            "enum": [
              "observed",
              "reported",
              "inferred",
              "unknown"
            ]
          }
        }
      }
    },
    "context_version": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
