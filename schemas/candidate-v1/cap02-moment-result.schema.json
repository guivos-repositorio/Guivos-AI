{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guivos-repositorio.github.io/Guivos-AI/schemas/candidate-v1/cap02-moment-result.schema.json",
  "title": "cap02-moment-result candidate-1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "dimensions",
    "as_of",
    "limitations"
  ],
  "properties": {
    "capability_id": {
      "const": "GAI-CAP-02"
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_ref",
          "knowledge_status",
          "evidence_refs"
        ],
        "properties": {
          "dimension_ref": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_status": {
            "enum": [
              "known",
              "reported",
              "contradictory",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
