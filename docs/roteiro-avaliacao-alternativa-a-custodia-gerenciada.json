  "criteria": [
    {
      "id": "A-SEC",
      "title": "Segurança e identidade",
      "weight": 25,
      "questions": [
        "Há MFA resistente a phishing para funções administrativas?",
        "É possível segregação RBAC/ABAC e revisão periódica de permissões?",
        "Como são gerenciadas chaves, criptografia e acessos emergenciais?",
        "Que evidências auditáveis existem sobre incidentes e recuperação?"
      ],
      "evidence": [
        "arquitetura de segurança",
        "descrição verificável de controles de identidade",
        "política de chaves e incidentes"
      ]
    },
    {
      "id": "A-PRIV",
      "title": "Privacidade e conformidade",
      "weight": 20,
      "questions": [
        "Quais papéis contratuais e bases legais são necessários?",
        "Onde dados, backups e suboperadores estão localizados?",
        "Como responder a direitos dos titulares e limitar finalidade?",
        "O fornecedor aceita cláusulas de proteção de dados e portabilidade?"
      ],
      "evidence": [
        "DPA/minuta contratual",
        "mapa de dados e suboperadores",
        "documento de transferências internacionais",
        "processo de direitos dos titulares"
      ]
    },
    {
      "id": "A-AUD",
      "title": "Auditoria e evidências",
      "weight": 15,
      "questions": [
        "Há logs de acesso, exportação, alteração e exclusão?",
        "Logs são protegidos de adulteração por administradores comuns?",
        "É possível entregar evidências a auditor independente?"
      ],
      "evidence": [
        "dicionário de eventos",
        "política de integridade e retenção de logs",
        "descrição de exportação de auditoria"
      ]
    },
    {
      "id": "A-RET",
      "title": "Retenção e exclusão",
      "weight": 15,
      "questions": [
        "Retenção é configurável por classe e base legal?",
        "Como funciona exclusão de objetos, réplicas e backups?",
        "São possíveis suspensão legal e comprovação do descarte?"
      ],
      "evidence": [
        "matriz de retenção configurável",
        "política de backup e exclusão",
        "procedimento de confirmação de descarte"
      ]
    },
    {
      "id": "A-TCO",
      "title": "Custo total",
      "weight": 10,
      "questions": [
        "Quais cobranças fixas, por usuário, armazenamento, operações e tráfego?",
        "Quais custos de implantação, suporte, auditoria e integração?",
        "Quais custos de saída e variação por volume?"
      ],
      "evidence": [
        "estrutura de preços por unidade",
        "premissas de volume",
        "condições comerciais e de cancelamento"
      ]
    },
    {
      "id": "A-OPS",
      "title": "Operação e resiliência",
      "weight": 10,
      "questions": [
        "Quais SLA, RPO/RTO e responsabilidades de configuração?",
        "Como operam patching, monitoramento e resposta a incidentes?",
        "Quais limites de API e capacidade?"
      ],
      "evidence": [
        "SLA e divisão de responsabilidade",
        "documentação de continuidade",
        "política de suporte"
      ]
    },
    {
      "id": "A-EXIT",
      "title": "Reversibilidade",
      "weight": 5,
      "questions": [
        "É possível exportar todos os documentos, metadados e trilhas pertinentes?",
        "Quais formatos são usados e quais restrições existem?",
        "Como confirmar fim de processamento e descarte após migração?"
      ],
      "evidence": [
        "especificação de exportação",
        "condições de saída",
        "plano de migração e descarte"
      ]
    }
  ],
